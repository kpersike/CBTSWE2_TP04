<div class="container mt-4">

    <h1 class="mb-4">Minha Livraria</h1>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Livros cadastrados</h2>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#modalCadastro">
            Cadastrar livro
        </button>
    </div>

    @if (Model.Livros.Count == 0)
    {
        <p>Nenhum livro cadastrado até o momento.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>ISBN</th>
                        <th>Ano de publicação</th>
                        <th>Status</th>
                        <th>Ações</th>
                        <th>Edição</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var livro in Model.Livros)
                    {
                        <tr>
                            <td>@livro.Id</td>
                            <td>@livro.Titulo</td>
                            <td>@livro.Autor</td>
                            <td>@livro.ISBN</td>
                            <td>@livro.AnoPublicacao</td>
                            <td>@livro.Status</td>

                            <td>
                                <form method="post"
                                      asp-page-handler="Excluir"
                                      asp-route-id="@livro.Id">

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Excluir
                                    </button>

                                </form>
                            </td>

                            <td>
                                <form method="post"
                                      asp-page-handler="Atualizar"
                                      asp-route-id="@livro.Id">

                                    <input type="hidden"
                                           name="LivroEdicao.Id"
                                           value="@livro.Id" />

                                    <input type="hidden"
                                           name="LivroEdicao.Titulo"
                                           value="@livro.Titulo" />

                                    <input type="hidden"
                                           name="LivroEdicao.Autor"
                                           value="@livro.Autor" />

                                    <input type="hidden"
                                           name="LivroEdicao.ISBN"
                                           value="@livro.ISBN" />

                                    <input type="hidden"
                                           name="LivroEdicao.AnoPublicacao"
                                           value="@livro.AnoPublicacao" />

                                    <input type="hidden"
                                           name="LivroEdicao.Status"
                                           value="@((int)livro.Status)" />

                                    <button type="button"
                                            class="btn btn-warning btn-sm"
                                            onclick="abrirEdicao(this)">
                                        Editar
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

<!-- MODAL DE CADASTRO -->
<div class="modal fade" id="modalCadastro" tabindex="-1"
     aria-labelledby="tituloModalCadastro" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalCadastro">
                    Cadastrar novo livro
                </h5>

                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                </button>
            </div>

            <form method="post">

                <div class="modal-body">

                    <div asp-validation-summary="ModelOnly"
                        class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="NovoLivro.Titulo"
                               class="form-label">
                            Título
                        </label>

                        <input asp-for="NovoLivro.Titulo"
                               class="form-control" />

                        <span asp-validation-for="NovoLivro.Titulo"
                            class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NovoLivro.Autor"
                               class="form-label">
                            Autor
                        </label>

                        <input asp-for="NovoLivro.Autor"
                               class="form-control" />

                        <span asp-validation-for="NovoLivro.Autor"
                            class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NovoLivro.ISBN"
                               class="form-label">
                            ISBN
                        </label>

                        <input asp-for="NovoLivro.ISBN"
                               class="form-control" />

                        <span asp-validation-for="NovoLivro.ISBN"
                            class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NovoLivro.AnoPublicacao"
                               class="form-label">
                            Ano de publicação
                        </label>

                        <input asp-for="NovoLivro.AnoPublicacao"
                               type="number"
                               class="form-control" />

                        <span asp-validation-for="NovoLivro.AnoPublicacao"
                            class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NovoLivro.Status"
                               class="form-label">
                            Status
                        </label>

                        <select asp-for="NovoLivro.Status"
                                class="form-select">
                            <option value="0">Para ler</option>
                            <option value="1">Lendo</option>
                            <option value="2">Lido</option>
                        </select>

                        <span asp-validation-for="NovoLivro.Status"
                            class="text-danger"></span>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Cadastrar livro
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<!-- MODAL DE EDIÇÃO -->
<div class="modal fade" id="modalEdicao" tabindex="-1"
     aria-labelledby="tituloModalEdicao" aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalEdicao">
                    Editar livro
                </h5>

                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                </button>
            </div>

            <form method="post" id="formEdicao">

                <div class="modal-body">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           name="LivroEdicao.Id"
                           id="edicaoId" />

                    <div class="mb-3">
                        <label class="form-label">Título</label>

                    <input asp-for="LivroEdicao.Titulo"
                           id="edicaoTitulo"
                           class="form-control" />

                    <span asp-validation-for="LivroEdicao.Titulo"
                          class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Autor</label>

                    <input asp-for="LivroEdicao.Autor"
                           id="edicaoAutor"
                           class="form-control" />

                    <span asp-validation-for="LivroEdicao.Autor"
                          class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">ISBN</label>

                    <input asp-for="LivroEdicao.ISBN"
                           id="edicaoISBN"
                           class="form-control" />

                    <span asp-validation-for="LivroEdicao.ISBN"
                          class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ano de publicação</label>

                    <input asp-for="LivroEdicao.AnoPublicacao"
                           type="number"
                           id="edicaoAno"
                           class="form-control" />

                    <span asp-validation-for="LivroEdicao.AnoPublicacao"
                          class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Status</label>

                    <select asp-for="LivroEdicao.Status"
                            id="edicaoStatus"
                            class="form-select">
                        <option value="0">Para ler</option>
                        <option value="1">Lendo</option>
                        <option value="2">Lido</option>
                    </select>

                    <span asp-validation-for="LivroEdicao.Status"
                          class="text-danger"></span>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-success">
                        Salvar alterações
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<script>
    function abrirEdicao(botao) {
        const formulario = botao.closest("form");

        document.getElementById("edicaoId").value =
            formulario.querySelector('[name="LivroEdicao.Id"]').value;

        document.getElementById("edicaoTitulo").value =
            formulario.querySelector('[name="LivroEdicao.Titulo"]').value;

        document.getElementById("edicaoAutor").value =
            formulario.querySelector('[name="LivroEdicao.Autor"]').value;

        document.getElementById("edicaoISBN").value =
            formulario.querySelector('[name="LivroEdicao.ISBN"]').value;

        document.getElementById("edicaoAno").value =
            formulario.querySelector('[name="LivroEdicao.AnoPublicacao"]').value;

        document.getElementById("edicaoStatus").value =
            formulario.querySelector('[name="LivroEdicao.Status"]').value;

        document.getElementById("formEdicao").action =
            "?handler=Atualizar&id=" +
            document.getElementById("edicaoId").value;

        const modal = new bootstrap.Modal(
            document.getElementById("modalEdicao")
        );

        modal.show();
    }
</script>

@if (Model.AbrirModalCadastro)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = new bootstrap.Modal(
                document.getElementById("modalCadastro")
            );

            modal.show();
        });
    </script>
}

@if (Model.AbrirModalEdicao)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = new bootstrap.Modal(
                document.getElementById("modalEdicao")
            );

            modal.show();
        });
    </script>
}
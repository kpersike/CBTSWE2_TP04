<div class="container mt-4">
    <h1 class="mb-4">Minha Livraria</h1>

    <h2 class="mb-3">Cadastrar novo livro</h2>

    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="NovoLivro.Titulo" class="form-label">Título</label>
            <input asp-for="NovoLivro.Titulo" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="NovoLivro.Autor" class="form-label">Autor</label>
            <input asp-for="NovoLivro.Autor" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="NovoLivro.ISBN" class="form-label">ISBN</label>
            <input asp-for="NovoLivro.ISBN" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="NovoLivro.AnoPublicacao" class="form-label">
                Ano de publicação
            </label>
            <input asp-for="NovoLivro.AnoPublicacao"
                   type="number"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="NovoLivro.Status" class="form-label">Status</label>
            <select asp-for="NovoLivro.Status" class="form-select">
                <option value="0">Para ler</option>
                <option value="1">Lendo</option>
                <option value="2">Lido</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Cadastrar livro
        </button>
    </form>

    <hr class="my-4" />

    <h2 class="mb-3">Livros cadastrados</h2>

    @if (Model.Livros.Count == 0)
    {
        <p>Nenhum livro cadastrado até o momento.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>ISBN</th>
                    <th>Ano de publicação</th>
                    <th>Status</th>
                    <th>Ações</th>
                    <th>Edição</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var livro in Model.Livros)
                {
                    <tr>
                        <td>@livro.Id</td>
                        <td>@livro.Titulo</td>
                        <td>@livro.Autor</td>
                        <td>@livro.ISBN</td>
                        <td>@livro.AnoPublicacao</td>
                        <td>@livro.Status</td>
                        <td>
                            <form method="post" asp-page-handler="Excluir"
                                  asp-route-id="@livro.Id">

                                <button type="submit" class="btn btn-danger btn-sm">
                                    Excluir
                                </button>

                            </form>
                        </td>

                        <td>
                            <form method="post" asp-page-handler="Atualizar"
                                  asp-route-id="@livro.Id">

                                <input type="hidden" name="LivroEdicao.Id"
                                       value="@livro.Id" />

                                <input type="hidden" name="LivroEdicao.Titulo"
                                       value="@livro.Titulo" />

                                <input type="hidden" name="LivroEdicao.Autor"
                                       value="@livro.Autor" />

                                <input type="hidden" name="LivroEdicao.ISBN"
                                       value="@livro.ISBN" />

                                <input type="hidden" name="LivroEdicao.AnoPublicacao"
                                       value="@livro.AnoPublicacao" />

                                <input type="hidden" name="LivroEdicao.Status"
                                       value="@((int)livro.Status)" />

                                <button type="button" class="btn btn-warning btn-sm"
                                        onclick="abrirEdicao(this)">
                                    Editar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div id="areaEdicao" class="mt-4" style="display:none;">
        <h2>Editar livro</h2>

        <form method="post" id="formEdicao">
            <input type="hidden" name="LivroEdicao.Id" id="edicaoId" />

            <div class="mb-3">
                <label class="form-label">Título</label>
                <input type="text" name="LivroEdicao.Titulo"
                       id="edicaoTitulo" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Autor</label>
                <input type="text" name="LivroEdicao.Autor"
                       id="edicaoAutor" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">ISBN</label>
                <input type="text" name="LivroEdicao.ISBN"
                       id="edicaoISBN" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Ano de publicação</label>
                <input type="number" name="LivroEdicao.AnoPublicacao"
                       id="edicaoAno" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <select name="LivroEdicao.Status" id="edicaoStatus"
                        class="form-select">
                    <option value="0">Para ler</option>
                    <option value="1">Lendo</option>
                    <option value="2">Lido</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success">
                Salvar alterações
            </button>

            <button type="button" class="btn btn-secondary"
                    onclick="fecharEdicao()">
                Cancelar
            </button>
        </form>
    </div>
</div>

<script>
    function abrirEdicao(botao) {
        const formulario = botao.closest("form");

        document.getElementById("edicaoId").value =
            formulario.querySelector('[name="LivroEdicao.Id"]').value;

        document.getElementById("edicaoTitulo").value =
            formulario.querySelector('[name="LivroEdicao.Titulo"]').value;

        document.getElementById("edicaoAutor").value =
            formulario.querySelector('[name="LivroEdicao.Autor"]').value;

        document.getElementById("edicaoISBN").value =
            formulario.querySelector('[name="LivroEdicao.ISBN"]').value;

        document.getElementById("edicaoAno").value =
            formulario.querySelector('[name="LivroEdicao.AnoPublicacao"]').value;

        document.getElementById("edicaoStatus").value =
            formulario.querySelector('[name="LivroEdicao.Status"]').value;

        document.getElementById("formEdicao").action =
            "?handler=Atualizar&id=" +
            document.getElementById("edicaoId").value;

        document.getElementById("areaEdicao").style.display = "block";
    }

    function fecharEdicao() {
        document.getElementById("areaEdicao").style.display = "none";
    }
</script>